# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Conservative music metadata matching engine for Rocksky"
description:
  "An OCaml music matching engine based on Rocksky's shared matching policy. Validates titles, artist credits, albums, recording versions, identifiers and durations before ranking candidates. Provides explainable decisions, explicit ambiguity handling, provider adapters and a JSON HTTP service."
maintainer: ["Tsiry Sandratraina <tsiry.sndr@rocksky.app>"]
authors: ["Tsiry Sandratraina <tsiry.sndr@rocksky.app>"]
license: "MIT"
tags: ["music" "metadata" "matching" "rocksky"]
homepage: "https://github.com/tsirysndr/rocksky"
doc: "https://github.com/tsirysndr/rocksky/tree/main/matcher"
bug-reports: "https://github.com/tsirysndr/rocksky/issues"
depends: [
  "dune" {>= "3.24"}
  "ocaml" {>= "5.2"}
  "uutf"
  "uucp"
  "uunf"
  "yojson"
  "lwt"
  "cohttp-lwt-unix" {>= "6.3"}
  "tls-lwt"
  "uri"
  "sqlite3"
  "postgresql"
  "digestif"
  "base64"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/tsirysndr/rocksky.git"
x-maintenance-intent: ["(latest)"]
