{
  "lexicon": 1,
  "id": "app.rocksky.library.getLyrics",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get lyrics for a song.",
      "parameters": {
        "type": "params",
        "properties": {
          "artist": {
            "type": "string",
            "description": "The artist name."
          },
          "title": {
            "type": "string",
            "description": "The song title."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "serverVersion": {
              "type": "string"
            },
            "openSubsonic": {
              "type": "boolean"
            },
            "lyrics": {
              "type": "unknown",
              "description": "Unmodified OpenSubsonic lyrics payload from Navidrome. Its provider-defined fields are preserved."
            }
          }
        }
      }
    }
  }
}
