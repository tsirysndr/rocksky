{
  "name": "@rocksky/api-gleam",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "gleam build",
    "db:generate-bindings": "bun scripts/generate_drizzle.ts",
    "dev": "concurrently 'bun run api' 'bun run xrpc'",
    "api": "gleam build && node entry/api.mjs",
    "xrpc": "gleam build && node entry/server.mjs",
    "prod": "node entry/api.mjs",
    "prod:xrpc": "node entry/server.mjs",
    "test": "gleam test && node --test test/*.test.mjs",
    "db:migrate": "gleam run -m rocksky_api/scripts/migrate",
    "sync": "gleam run -m rocksky_api/scripts/sync",
    "typesense:import": "gleam run -m rocksky_api/scripts/typesense_import",
    "sync:library": "gleam run -m rocksky_api/scripts/sync_library",
    "sync:library-playlist": "gleam run -m rocksky_api/scripts/sync_library_playlist",
    "avatar": "gleam run -m rocksky_api/scripts/avatar",
    "genres": "gleam run -m rocksky_api/scripts/genres",
    "spotify": "gleam run -m rocksky_api/scripts/spotify",
    "exp": "gleam run -m rocksky_api/scripts/exp",
    "collections": "gleam run -m rocksky_api/scripts/collections",
    "feed": "gleam run -m rocksky_api/scripts/feed",
    "event": "gleam run -m rocksky_api/scripts/event",
    "dedup": "gleam run -m rocksky_api/scripts/dedup",
    "dedup:records": "gleam run -m rocksky_api/scripts/dedup_records",
    "seed:feed": "gleam run -m rocksky_api/scripts/seed_feed",
    "likes": "gleam run -m rocksky_api/scripts/likes",
    "backfill:likes": "gleam run -m rocksky_api/scripts/backfill_likes",
    "backfill:isrc-mbid": "gleam run -m rocksky_api/scripts/backfill_isrc_mbid",
    "riff:backfill": "gleam run -m rocksky_api/scripts/backfill_riff",
    "backfill:track-uri": "gleam run -m rocksky_api/scripts/backfill_track_uri",
    "backfill:replaygain": "gleam run -m rocksky_api/scripts/backfill_replaygain",
    "backfill:analysis": "gleam run -m rocksky_api/scripts/backfill_analysis",
    "backfill:discogs": "gleam run -m rocksky_api/scripts/backfill_discogs",
    "backfill:fingerprint": "BACKFILL_ONLY=fingerprint gleam run -m rocksky_api/scripts/backfill_analysis"
  },
  "dependencies": {
    "@atproto/api": "^0.13.31",
    "@atproto/common": "^0.4.6",
    "@atproto/identity": "^0.4.5",
    "@atproto/jwk-jose": "0.1.11",
    "@atproto/lexicon": "^0.4.5",
    "@atproto/oauth-client-node": "0.3.16",
    "@atproto/syntax": "^0.3.1",
    "@atproto/xrpc-server": "^0.7.8",
    "@aws-sdk/client-s3": "^3.1052.0",
    "@aws-sdk/s3-request-presigner": "^3.1052.0",
    "@hono/node-server": "^1.13.8",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.200.0",
    "@opentelemetry/auto-instrumentations-node": "^0.58.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.200.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.200.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.200.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-logs": "^0.200.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@opentelemetry/sdk-node": "^0.200.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@pyroscope/nodejs": "^0.4.5",
    "@rocksky/analysis": "workspace:*",
    "@rsql/ast": "^1.6.0",
    "@rsql/parser": "^1.6.0",
    "axios": "^1.7.9",
    "better-sqlite3": "^12.4.1",
    "chalk": "^5.4.1",
    "consola": "^3.4.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.2",
    "express": "^5.1.0",
    "googleapis": "^146.0.0",
    "hono": "^4.4.7",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "libsodium-wrappers": "^0.8.4",
    "music-metadata": "^11.12.3",
    "nats": "^2.29.2",
    "node-cron": "^4.2.1",
    "node-taglib-sharp": "^6.0.3",
    "pg": "^8.13.3",
    "redis": "^4.7.0",
    "redlock": "^5.0.0-beta.2",
    "sharp": "^0.33.5",
    "typesense": "^3.0.6",
    "uuid": "^11.1.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
