//// Hands scrobbles to the Rust submissions queue; never falls back to an
//// in-memory pipeline.

import gleam/dynamic/decode
import gleam/json.{type Json}
import gleam/list
import gleam/option.{type Option, None, Some}
import gleam/string
import rocksky_api/error.{type Error}
import rocksky_api/lib/track.{type Track}
import rocksky_api/node/axios
import rocksky_api/node/crypto
import rocksky_api/task.{type Task}

pub type Config {
  Config(url: String, secret: String)
}

pub const unavailable =
  "Submission could not be durably accepted; retry with the same timestamp or Idempotency-Key"

pub fn unavailable_error() -> Error {
  error.Upstream(503, unavailable)
}

pub fn valid_secret(provided: Option(String), expected: String) -> Bool {
  case provided, string.length(expected) >= 32 {
    Some(p), True -> crypto.timing_safe_equal(p, expected)
    _, _ -> False
  }
}

/// The lexicon TID key generated by Rust and saved with the job.
pub fn record_key(key: String) -> Result(String, Error) {
  case is_tid(key) {
    True -> Ok(key)
    False -> Error(error.InvalidRequest("Invalid submission record key"))
  }
}

@external(javascript, "./durable_submission_ffi.mjs", "isTid")
fn is_tid(key: String) -> Bool

@external(javascript, "./durable_submission_ffi.mjs", "isJobId")
pub fn is_job_id(id: String) -> Bool

pub fn idempotency_key(
  did: String,
  t: Track,
  explicit: Option(String),
) -> String {
  case explicit, t.timestamp {
    Some(k), _ if k != "" -> k
    _, Some(ts) ->
      crypto.sha256_hex(
        json.to_string(
          json.preprocessed_array([
            json.string(did),
            json.string(string.lowercase(t.title)),
            json.string(string.lowercase(t.artist)),
            json.string(string.lowercase(t.album)),
            json.int(ts),
          ]),
        ),
      )
    _, None -> crypto.random_uuid()
  }
}

pub fn enqueue(
  config: Config,
  did: String,
  t: Track,
  explicit_key: Option(String),
  skip_teal: Bool,
) -> Task(String) {
  let body =
    json.object(
      list.flatten([
        [
          #("did", json.string(did)),
          #("track", track.to_json(t)),
          #(
            "idempotencyKey",
            json.string(idempotency_key(did, t, explicit_key)),
          ),
        ],
        case skip_teal {
          True -> [#("skipTeal", json.bool(True))]
          False -> []
        },
      ]),
    )
  enqueue_durable(config, "/v1/submissions", body)
}

pub fn enqueue_teal(
  config: Config,
  did: String,
  record: Json,
  idempotency_key: String,
) -> Task(String) {
  enqueue_durable(
    config,
    "/v1/tealfm",
    json.object([
      #("did", json.string(did)),
      #("record", record),
      #("idempotencyKey", json.string(idempotency_key)),
    ]),
  )
}

fn enqueue_durable(config: Config, path: String, input: Json) -> Task(String) {
  case config.url == "" || string.length(config.secret) < 32 {
    True ->
      task.fail(error.Upstream(503, "Durable submissions are not configured"))
    False -> {
      let base = case string.ends_with(config.url, "/") {
        True -> string.drop_end(config.url, 1)
        False -> config.url
      }
      let options =
        axios.Options(
          headers: [
            #("content-type", "application/json"),
            #("x-rocksky-submissions-secret", config.secret),
          ],
          params: [],
          timeout_ms: Some(15_000),
          response_type: None,
          validate_status: True,
        )
      use response <- task.then(
        task.attempt_result(axios.post(
          axios.global(),
          base <> path,
          input,
          options,
        ))
        |> task.map_error(fn(_) { unavailable_error() }),
      )
      case response.status {
        202 ->
          case decode.run(response.data, decode.at(["id"], decode.string)) {
            Ok(id) if id != "" ->
              case is_job_id(id) {
                True -> task.ok(id)
                False -> task.fail(unavailable_error())
              }
            _ -> task.fail(unavailable_error())
          }
        _ -> task.fail(unavailable_error())
      }
    }
  }
}
