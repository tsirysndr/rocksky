SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

SPOTIFY_ENCRYPTION_KEY=
SPOTIFY_ENCRYPTION_IV=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

XATA_POSTGRES_URL="postgresql://postgres:mysecretpassword@localhost:5433/rocksky?sslmode=disable"
# Optional read/write split. Both fall back to XATA_POSTGRES_URL when unset,
# so a deployment that sets only the line above keeps working unchanged.
# XATA_READ_POSTGRES_URL=""   # read-only replica: lag-tolerant reads
# XATA_WRITE_POSTGRES_URL=""  # primary: all writes, plus scrobbles/now-playing/follows/likes

JWT_SECRET=

# v1 (default), v2, or both. Both share one deduplicated durable inbox.
JETSTREAM_VERSION=v1
JETSTREAM_SERVER=wss://jetstream2.us-east.bsky.network
# Optional: connect to multiple Jetstream servers in parallel for reliability.
# Comma-separated; events are merged and deduplicated. Overrides JETSTREAM_SERVER when set.
# JETSTREAM_SERVERS=wss://jetstream1.us-east.bsky.network,wss://jetstream2.us-east.bsky.network,wss://jetstream1.us-west.bsky.network,wss://jetstream2.us-west.bsky.network
# V2 defaults to both regions. Comma-separated URLs override JETSTREAM_V2_URL.
# JETSTREAM_V2_URLS=wss://jetstream.us-west.bsky.network,wss://jetstream.us-east.bsky.network
# JETSTREAM_V2_URL=wss://jetstream.us-west.bsky.network
# Optional initial SEQUENCE, only with a single v2 URL; not a v1 timestamp.
# JETSTREAM_V2_CURSOR=
# Repos whose community.lexicon.calendar.event + app.rocksky.event.music records
# are indexed as music events. Comma-separated DIDs, `*` for any repo. Defaults
# to tsiry-sandratraina.com and rocksky.app.
# EVENT_PUBLISHER_DIDS=did:plc:7vdlgi2bflelz7mmuxoqjfcr,did:plc:vegqomyce4ssoqs7zwqvgqty
# Replay the firehose from this point (unix microseconds) on the first
# connection instead of starting live, e.g. to re-index commits a previous
# build could not handle. Unset it again after the restart.
# JETSTREAM_CURSOR=

SCROBBLER_ORIGIN_URL="http://localhost:7882"

SOURCE_POSTGRES_URL=

# Discogs personal access token (https://www.discogs.com/settings/developers).
# Required by the discogs/ service, which exits without it.
DISCOGS_TOKEN=
