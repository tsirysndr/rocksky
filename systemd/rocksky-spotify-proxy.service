[Unit]
Description=Rocksky Spotify Proxy Service
After=network.target rocksky-riff.service
Wants=network-online.target
# Catalog reads are served by riff; Wants (not Requires) because the proxy
# falls back to Spotify on its own when riff is down.
Wants=rocksky-riff.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/github/rocksky
ExecStart=/bin/bash -ic 'exec bun run spotify-proxy'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rocksky-spotify-proxy

# Environment
Environment=HOME=/root
Environment=USER=root

[Install]
WantedBy=multi-user.target
