[Unit]
Description=Rocksky Spotify Proxy Service
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/github/rocksky
ExecStart=/bin/bash -ic 'exec bun run spotify-proxy'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rocksky-spotify-proxy

# Environment
Environment=HOME=/root
Environment=USER=root

[Install]
WantedBy=multi-user.target
