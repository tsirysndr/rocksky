[Unit]
Description=Rocksky Track Matching Service
After=network-online.target rocksky-deezer.service rocksky-mb.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/github/rocksky
# Build from the repository root: cargo build --release -p rockskyd
ExecStart=/bin/bash -ic 'exec doppler run -- ./target/release/rockskyd matching'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rocksky-matching

# Match the environment used by the other Doppler-managed services.
Environment=HOME=/root
Environment=USER=root

# Provider defaults; deployment secrets are injected by Doppler.
Environment=MATCHING_BIND=127.0.0.1:8096
Environment=DEEZER_URL=http://127.0.0.1:8090
Environment=MUSICBRAINZ_URL=http://127.0.0.1:8088
EnvironmentFile=-/etc/default/rocksky-matching

[Install]
WantedBy=multi-user.target
