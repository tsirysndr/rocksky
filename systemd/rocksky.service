[Unit]
Description=Rocksky Service
After=network.target rocksky-matching.service
Wants=network-online.target rocksky-matching.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/github/rocksky
ExecStart=/bin/bash -ic 'exec doppler run -c prd -- turbo prod --filter=@rocksky/api --env-mode=loose'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rocksky

# Environment
Environment=HOME=/root
Environment=USER=root
Environment=MATCHING_URL=http://127.0.0.1:8097

[Install]
WantedBy=multi-user.target
