[Unit]
Description=Rocksky Jetstream Service
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/github/rocksky
ExecStart=/bin/bash -ic 'exec doppler run -- ./target/release/rockskyd jetstream'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rocksky-jetstream

# Environment
Environment=HOME=/root
Environment=USER=root
# Bound bulk imports so other actors retain database capacity.
Environment=JETSTREAM_FAIR_BORROW_IDLE=false
Environment=JETSTREAM_MAX_INFLIGHT_PER_DID=4

[Install]
WantedBy=multi-user.target
