[Unit]
Description=Rocksky Discogs Service
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/github/rocksky
# DISCOGS_TOKEN comes from Doppler; the service exits without it, and
# baking it into this unit would leave it readable in systemctl show.
ExecStart=/bin/bash -ic 'exec doppler run --silent -- bun run discogs'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rocksky-discogs

# Environment
Environment=HOME=/root
Environment=USER=root

[Install]
WantedBy=multi-user.target
