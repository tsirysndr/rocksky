[Unit]
Description=Rocksk Musicbrainz Service
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/github/rocksky
ExecStart=/bin/bash -ic 'exec bun run mb'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rocksky-mb

# Environment
Environment=HOME=/root
Environment=USER=root
# MBRIFF_URL lives here (default http://localhost:8094): the local riff-mb is
# queried first on every request, the real rate-limited MusicBrainz API only
# when it has nothing.
EnvironmentFile=-/etc/default/rocksky-mb

[Install]
WantedBy=multi-user.target
