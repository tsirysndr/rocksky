[Unit]
Description=Rocksky XRPC Service
After=network.target rocksky-matching.service
Wants=network-online.target rocksky-matching.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/github/rocksky/apps/api
ExecStart=/bin/bash -ic 'exec doppler run -- bun run prod:xrpc'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rocksky-xrpc

# Environment
Environment=HOME=/root
Environment=USER=root
Environment=MATCHING_URL=http://127.0.0.1:8097

[Install]
WantedBy=multi-user.target
