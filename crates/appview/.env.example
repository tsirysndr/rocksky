# Optional settings for `docker compose -f crates/appview/compose.yml up`.
#
#   cp crates/appview/.env.example crates/appview/.env
#
# Nothing here is required. Every value below has a working default, and
# `compose.yml` supplies one for each — an instance started with no `.env` at
# all boots, serves the UI and accepts logins. Docker Compose reads the `.env`
# sitting next to the compose file, so it belongs in this directory and not at
# the repository root (the root `.env` configures `apps/api`, which is a
# separate deployment).
#
# The appview itself needs no secrets to start: on first boot it writes a
# signing key, its OAuth keys and a `config.toml` into the `data` volume. It
# does not read a `.env` — these values reach it as compose environment
# variables.

# --- Running on a real domain --------------------------------------------
#
# Set both to move off localhost. The appview then registers as a
# *confidential* OAuth client, serving its own client metadata and JWKS, which
# is what lets a session outlive the loopback flow. Leave them unset and the
# loopback client is used, which works on localhost only.
#
# Set these to the address a browser reaches, not the container's — the OAuth
# redirect and every absolute URL are built from them.
#ROCKSKY_DOMAIN=rocksky.example.com
#ROCKSKY_PUBLIC_URL=https://rocksky.example.com

# --- Search ---------------------------------------------------------------
#
# Shared between the appview and the typesense container, so changing it here
# changes both. The default is fine on a private network, where the index
# holds nothing the public API does not already serve, and not fine once the
# port is reachable.
#TYPESENSE_API_KEY=rocksky

# --- The firehose ---------------------------------------------------------
#
# Tap's admin password, shared the same way. Only needed to register extra
# repositories by hand; the backfill in `compose.yml` does not use it.
#TAP_ADMIN_PASSWORD=rocksky

# A relay to read from, and how loud Tap is about it.
#TAP_RELAY_URL=https://relay1.us-east.bsky.network
#TAP_LOG_LEVEL=info

# --- The feed generator (`--profile feeds`) --------------------------------
#
# The feeds service reads the same database as the appview. A SQLite file
# cannot be shared between containers, so this is only usable with Postgres.
#XATA_POSTGRES_URL=postgres://user:pass@host:5432/rocksky

# The did:web is derived from this, so it must be the public hostname.
#ROCKSKY_FEEDGEN_DOMAIN=feeds.rocksky.example.com

# Whose repository holds the app.rocksky.feed.generator records. Unset means
# the rocksky.app account, which is right for a mirror and wrong if you
# publish your own feeds.
#ROCKSKY_FEEDGEN_PUBLISHER_DID=did:plc:…

# --- Filling the database by hand -----------------------------------------
#
# Repositories to project on boot, comma-separated. Safe to leave set: the
# projection is keyed on content hashes, so a re-run updates rows rather than
# duplicating them. Tap does this continuously and for the whole network, so
# this is for pulling in one account in particular.
#ROCKSKY_BACKFILL_DIDS=did:plc:…
#ROCKSKY_BACKFILL_ON_START=true

# --- Logging --------------------------------------------------------------
#RUST_LOG=info,sqlx=warn
