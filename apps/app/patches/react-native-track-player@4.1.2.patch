+    // Bridgeless (new architecture) exposes the React context on ReactHost;
+    // reactInstanceManager.currentReactContext is always null there, which
+    // silently dropped every event.
+    private val emitterReactContext: com.facebook.react.bridge.ReactContext?
+        get() {
+            val app = application as? com.facebook.react.ReactApplication
+            return app?.reactHost?.currentReactContext
+                ?: reactNativeHost.reactInstanceManager.currentReactContext
+        }
+
     @MainThread
     private fun emit(event: String, data: Bundle? = null) {
-        reactNativeHost.reactInstanceManager.currentReactContext
+        emitterReactContext
             ?.getJSModule(DeviceEventManagerModule.RCTDeviceEventEmitter::class.java)
