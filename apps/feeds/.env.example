XATA_POSTGRES_URL="postgresql://postgres:mysecretpassword@localhost:5433/rocksky?sslmode=disable"
# Optional read/write split. Both fall back to XATA_POSTGRES_URL when unset,
# so a deployment that sets only the line above keeps working unchanged.
# XATA_READ_POSTGRES_URL=""   # read-only replica: lag-tolerant reads
# XATA_WRITE_POSTGRES_URL=""  # primary: all writes, plus scrobbles/now-playing/follows/likes
ROCKSKY_FEEDGEN_DOMAIN=discover.rocksky.app
ROCKSKY_FEEDGEN_PORT=8003
NODE_ENV=development
