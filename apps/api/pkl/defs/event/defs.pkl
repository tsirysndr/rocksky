amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.event.defs"
defs = new Mapping<String, BaseType> {
  ["eventView"] = new ObjectType {
    type = "object"
    description = "A music event: the calendar event merged with its app.rocksky.event.music annotation."
    required = List("id", "uri", "musicUri", "name", "artists", "locations", "uris", "rsvpCounts", "organizerDid", "createdAt", "updatedAt")
    properties {
      ["id"] = new StringType {
        type = "string"
        description = "The unique identifier of the event."
      }
      ["uri"] = new StringType {
        type = "string"
        description = "AT-URI of the community.lexicon.calendar.event record."
        format = "at-uri"
      }
      ["cid"] = new StringType {
        type = "string"
        description = "CID of the calendar event record revision that was indexed."
        format = "cid"
      }
      ["musicUri"] = new StringType {
        type = "string"
        description = "AT-URI of the app.rocksky.event.music record."
        format = "at-uri"
      }
      ["musicCid"] = new StringType {
        type = "string"
        description = "CID of the music record revision that was indexed."
        format = "cid"
      }
      ["name"] = new StringType {
        type = "string"
        description = "The name of the event."
      }
      ["description"] = new StringType {
        type = "string"
        description = "The description of the event."
      }
      ["kind"] = new StringType {
        type = "string"
        description = "What sort of music event this is (concert, festival...)."
        knownValues = List("concert", "festival", "club-night", "dj-set", "livestream", "release-party", "listening-party")
      }
      ["genre"] = new StringType {
        type = "string"
        description = "The main genre of the event."
      }
      ["tags"] = new Array {
        type = "array"
        items = new StringType {
          type = "string"
        }
      }
      ["startsAt"] = new StringType {
        type = "string"
        description = "When the event starts."
        format = "datetime"
      }
      ["endsAt"] = new StringType {
        type = "string"
        description = "When the event ends."
        format = "datetime"
      }
      ["mode"] = new StringType {
        type = "string"
        description = "The attendance mode, as a community.lexicon.calendar.event#mode token."
        knownValues = List("community.lexicon.calendar.event#inperson", "community.lexicon.calendar.event#virtual", "community.lexicon.calendar.event#hybrid")
      }
      ["status"] = new StringType {
        type = "string"
        description = "The event status, as a community.lexicon.calendar.event#status token."
        knownValues = List("community.lexicon.calendar.event#planned", "community.lexicon.calendar.event#scheduled", "community.lexicon.calendar.event#rescheduled", "community.lexicon.calendar.event#cancelled", "community.lexicon.calendar.event#postponed")
      }
      ["imageUrl"] = new StringType {
        type = "string"
        description = "Poster or banner image of the event."
        format = "uri"
      }
      ["ticketsUrl"] = new StringType {
        type = "string"
        description = "Where tickets can be bought."
        format = "uri"
      }
      ["locations"] = new Array {
        type = "array"
        description = "Where the event takes place."
        items = new Ref {
          type = "ref"
          ref = "app.rocksky.event.defs#locationView"
        }
      }
      ["uris"] = new Array {
        type = "array"
        description = "Links associated with the event."
        items = new Ref {
          type = "ref"
          ref = "app.rocksky.event.defs#uriView"
        }
      }
      ["artists"] = new Array {
        type = "array"
        description = "The lineup, in billing order."
        items = new Ref {
          type = "ref"
          ref = "app.rocksky.event.defs#artistView"
        }
      }
      ["externalIds"] = new Ref {
        type = "ref"
        ref = "app.rocksky.event.music#externalIds"
      }
      ["organizerDid"] = new StringType {
        type = "string"
        description = "The DID of the repo that published the event."
        format = "did"
      }
      ["organizerHandle"] = new StringType {
        type = "string"
        description = "The handle of the publisher."
      }
      ["organizerName"] = new StringType {
        type = "string"
        description = "The display name of the publisher."
      }
      ["organizerAvatarUrl"] = new StringType {
        type = "string"
        description = "The avatar of the publisher."
        format = "uri"
      }
      ["rsvpCounts"] = new Ref {
        type = "ref"
        ref = "app.rocksky.event.defs#rsvpCounts"
      }
      ["viewerRsvp"] = new StringType {
        type = "string"
        description = "The authenticated viewer's RSVP, as a community.lexicon.calendar.rsvp status token. Absent when not authenticated or when the viewer has not responded."
        knownValues = List("community.lexicon.calendar.rsvp#going", "community.lexicon.calendar.rsvp#interested", "community.lexicon.calendar.rsvp#notgoing")
      }
      ["createdAt"] = new StringType {
        type = "string"
        description = "When the event record was created."
        format = "datetime"
      }
      ["updatedAt"] = new StringType {
        type = "string"
        description = "When the event was last indexed."
        format = "datetime"
      }
    }
  }
  ["artistView"] = new ObjectType {
    type = "object"
    description = "An artist on an event lineup, linked to the Rocksky artist when one was resolved."
    required = List("name")
    properties {
      ["id"] = new StringType {
        type = "string"
        description = "The unique identifier of the linked Rocksky artist."
      }
      ["uri"] = new StringType {
        type = "string"
        description = "AT-URI of the linked artist."
        format = "at-uri"
      }
      ["sha256"] = new StringType {
        type = "string"
        description = "The SHA256 hash of the linked artist."
      }
      ["name"] = new StringType {
        type = "string"
        description = "The artist name as billed on the event."
      }
      ["picture"] = new StringType {
        type = "string"
        description = "The picture of the linked artist."
      }
      ["mbid"] = new StringType {
        type = "string"
        description = "MusicBrainz artist id."
      }
      ["role"] = new StringType {
        type = "string"
        description = "The artist's billing on this event."
        knownValues = List("headliner", "support", "opener", "dj", "special-guest", "performer")
      }
      ["stage"] = new StringType {
        type = "string"
        description = "The stage the artist plays on."
      }
      ["startsAt"] = new StringType {
        type = "string"
        description = "When this artist's set starts."
        format = "datetime"
      }
    }
  }
  ["locationView"] = new ObjectType {
    type = "object"
    description = "One entry of the calendar event's locations, flattened: `type` says which community.lexicon.location shape it came from, and only the fields of that shape are set."
    required = List("type")
    properties {
      ["type"] = new StringType {
        type = "string"
        knownValues = List("community.lexicon.location.address", "community.lexicon.location.geo", "community.lexicon.location.fsq", "community.lexicon.location.hthree", "community.lexicon.calendar.event#uri")
      }
      ["name"] = new StringType {
        type = "string"
        description = "The name of the location (venue name)."
      }
      ["country"] = new StringType {
        type = "string"
        description = "ISO 3166 country code."
      }
      ["postalCode"] = new StringType {
        type = "string"
      }
      ["region"] = new StringType {
        type = "string"
      }
      ["locality"] = new StringType {
        type = "string"
        description = "City or town."
      }
      ["street"] = new StringType {
        type = "string"
      }
      ["latitude"] = new StringType {
        type = "string"
      }
      ["longitude"] = new StringType {
        type = "string"
      }
      ["altitude"] = new StringType {
        type = "string"
      }
      ["fsqPlaceId"] = new StringType {
        type = "string"
        description = "Foursquare Open Source Places id."
      }
      ["h3"] = new StringType {
        type = "string"
        description = "H3 encoded location."
      }
      ["uri"] = new StringType {
        type = "string"
        description = "A URL standing in for the location (online events)."
        format = "uri"
      }
    }
  }
  ["uriView"] = new ObjectType {
    type = "object"
    required = List("uri")
    properties {
      ["uri"] = new StringType {
        type = "string"
        format = "uri"
      }
      ["name"] = new StringType {
        type = "string"
        description = "The display name of the URI."
      }
    }
  }
  ["rsvpCounts"] = new ObjectType {
    type = "object"
    required = List("going", "interested", "notGoing")
    properties {
      ["going"] = new IntegerType {
        type = "integer"
        minimum = 0
      }
      ["interested"] = new IntegerType {
        type = "integer"
        minimum = 0
      }
      ["notGoing"] = new IntegerType {
        type = "integer"
        minimum = 0
      }
    }
  }
  ["rsvpView"] = new ObjectType {
    type = "object"
    description = "A community.lexicon.calendar.rsvp on an event, with its author."
    required = List("uri", "status", "did", "handle", "displayName", "createdAt")
    properties {
      ["uri"] = new StringType {
        type = "string"
        description = "AT-URI of the rsvp record."
        format = "at-uri"
      }
      ["cid"] = new StringType {
        type = "string"
        format = "cid"
      }
      ["status"] = new StringType {
        type = "string"
        knownValues = List("community.lexicon.calendar.rsvp#going", "community.lexicon.calendar.rsvp#interested", "community.lexicon.calendar.rsvp#notgoing")
      }
      ["did"] = new StringType {
        type = "string"
        format = "did"
      }
      ["handle"] = new StringType {
        type = "string"
      }
      ["displayName"] = new StringType {
        type = "string"
      }
      ["avatar"] = new StringType {
        type = "string"
        format = "uri"
      }
      ["createdAt"] = new StringType {
        type = "string"
        format = "datetime"
      }
    }
  }
}
