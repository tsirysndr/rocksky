amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.event.getEvents"
defs = new Mapping<String, Query> {
  ["main"] {
    type = "query"
    description = "List indexed music events, soonest first. Without a time window only unexpired events are returned: those ending (or, with no end, starting) today or later, plus undated ones."
    parameters {
      type = "params"
      properties {
        ["artist"] = new StringType {
          type = "string"
          description = "Only events this artist plays: the artist's AT-URI, id or sha256."
        }
        ["did"] = new StringType {
          type = "string"
          description = "Only events published by this repo."
          format = "did"
        }
        ["rsvpBy"] = new StringType {
          type = "string"
          description = "Only events this DID has RSVP'd to (going or interested)."
          format = "did"
        }
        ["kind"] = new StringType {
          type = "string"
          description = "Only events of this kind (concert, festival...)."
        }
        ["genre"] = new StringType {
          type = "string"
          description = "Only events whose genre matches (case-insensitive)."
        }
        ["from"] = new StringType {
          type = "string"
          description = "Only events that end at or after this time. Defaults to the start of today (UTC) when neither `to` nor `includePast` is given."
          format = "datetime"
        }
        ["to"] = new StringType {
          type = "string"
          description = "Only events that start at or before this time."
          format = "datetime"
        }
        ["includePast"] = new BooleanType {
          type = "boolean"
          description = "Return past events too, most recent first, instead of upcoming ones."
        }
        ["limit"] = new IntegerType {
          type = "integer"
          description = "The maximum number of events to return."
          minimum = 1
          maximum = 100
          default = 20
        }
        ["offset"] = new IntegerType {
          type = "integer"
          description = "The offset for pagination."
          minimum = 0
          default = 0
        }
      }
    }
    output {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        required = List("events")
        properties = new Mapping<String, BaseType> {
          ["events"] = new Array {
            type = "array"
            items = new Ref {
              type = "ref"
              ref = "app.rocksky.event.defs#eventView"
            }
          }
        }
      }
    }
  }
}
