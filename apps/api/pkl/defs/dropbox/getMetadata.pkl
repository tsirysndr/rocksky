amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.dropbox.getMetadata"
defs = new Mapping<String, BaseType> {
  ["main"] = new Query {
    type = "query"
    description = "Retrieve metadata of a file or folder in Dropbox"
    parameters = new {
      type = "params"
      required = List("path")
      properties = new Mapping<String, BaseType> {
        ["path"] = new StringType {
          type = "string"
          description = "Path to the file or folder in Dropbox"
        }
      }
    }
    output = new {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        properties = new Mapping<String, BaseType> {
          ["metadata"] = new UnknownType {
            type = "unknown"
            description = "Metadata returned by the provider; currently an empty object."
          }
        }
      }
    }
  }
}
