amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.stats.getWrapped"
defs = new Mapping<String, Query> {
  ["main"] {
    type = "query"
    description = "Get a user's Wrapped stats for a year or a recent rolling window"
    parameters = new Params {
      required = List("did")
      properties {
        ["did"] = new StringType {
          description = "The DID or handle of the user"
          format = "at-identifier"
        }
        ["year"] = new IntegerType {
          type = "integer"
          description = "The year to get wrapped stats for (defaults to current year)"
          minimum = 2000
        }
        ["period"] = new StringType {
          type = "string"
          description = "The window to compute stats over: a calendar year (see year), or a rolling window ending now. Defaults to year."
          knownValues = List("year", "3months", "month", "2weeks", "week")
        }
      }
    }
    output {
      encoding = "application/json"
      schema = new Ref {
        type = "ref"
        ref = "app.rocksky.stats.defs#wrappedView"
      }
    }
  }
}
