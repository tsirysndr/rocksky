amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.album.getAlbums"
defs = new Mapping<String, Query> {
  ["main"] {
    type = "query"
    description = "Get albums"
    parameters = new Params {
      properties {
        ["limit"] = new IntegerType {
          type = "integer"
          description = "The maximum number of albums to return"
          minimum = 1
        }
        ["offset"] = new IntegerType {
          type = "integer"
          description = "The offset for pagination"
          minimum = 0
        }
        ["genre"] = new StringType {
          type = "string"
          description = "The genre to filter artists by"
        }
        ["filter"] = new StringType {
          type = "string"
          description = "RSQL filter expression, e.g. `artist==\"Daft Punk\";year=ge=2000`. Supports ==, !=, <, <=, >, >=, =in=, =out=, and `;`/`and`, `,`/`or` combinators, `*` wildcards in string values. Filterable fields: title, artist, year, releaseDate, sha256, uri, artistUri, createdAt"
          maxLength = 2048
        }
      }
    }
    output {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        properties = new Mapping<String, Array> {
          ["albums"] = new Array {
            type = "array"
            items = new Ref {
              ref = "app.rocksky.album.defs#albumViewBasic"
            }
          }
        }
      }
    }
  }
}
