amends  "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.charts.defs"
defs = new Mapping<String, ObjectType> {
  ["chartsView"] {
    type = "object"
    properties {
      ["scrobbles"] = new Array {
        type = "array"
        items = new Ref {
          type = "ref"
          ref = "app.rocksky.charts.defs#scrobbleViewBasic"
        }
      }
    }
  }
  ["scrobbleViewBasic"] {
    type = "object"
    properties {
      ["date"] = new StringType {
        type = "string"
        description = "The date of the scrobble."
        format = "datetime"
      }
      ["count"] = new IntegerType {
        type = "integer"
        description = "The number of scrobbles on this date."
      }
    }
  }
  ["scrobblerViewBasic"] {
    type = "object"
    properties {
      ["id"] = new StringType {
        type = "string"
        description = "The unique identifier of the actor."
      }
      ["did"] = new StringType {
        type = "string"
        description = "The DID of the actor."
      }
      ["handle"] = new StringType {
        type = "string"
        description = "The handle of the actor."
      }
      ["displayName"] = new StringType {
        type = "string"
        description = "The display name of the actor."
      }
      ["avatar"] = new StringType {
        type = "string"
        format = "uri"
        description = "The URL of the actor's avatar image."
      }
      ["scrobbles"] = new IntegerType {
        type = "integer"
        description = "The number of scrobbles in the requested window."
      }
      ["uniqueArtists"] = new IntegerType {
        type = "integer"
        description = "The number of distinct artists scrobbled in the window."
      }
      ["uniqueTracks"] = new IntegerType {
        type = "integer"
        description = "The number of distinct tracks scrobbled in the window."
      }
    }
  }
}