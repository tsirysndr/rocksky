amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.apikey.createApikey"
defs = new Mapping<String, BaseType> {
  ["main"] = new Procedure {
    type = "procedure"
    description = "Create a new API key for the authenticated user"
    input = new {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        required = List("name")
        properties = new Mapping<String, BaseType> {
          ["name"] = new StringType {
            type = "string"
            description = "The name of the API key."
          }
          ["description"] = new StringType {
            type = "string"
            description = "A description for the API key."
          }
        }
      }
    }
    output = new {
      encoding = "application/json"
      schema = new Ref {
        type = "ref"
        ref = "app.rocksky.apikey.defs#apiKeyView"
      }
    }
  }
}
