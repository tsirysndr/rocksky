amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.apikey.removeApikey"
defs = new Mapping<String, BaseType> {
  ["main"] = new Procedure {
    type = "procedure"
    description = "Remove an API key for the authenticated user"
    parameters = new {
      type = "params"
      required = List("id")
      properties = new Mapping<String, BaseType> {
        ["id"] = new StringType {
          type = "string"
          description = "The ID of the API key to remove."
        }
      }
    }
    output = new {
      encoding = "application/json"
      schema = new Ref {
        type = "ref"
        ref = "app.rocksky.apikey.defs#apiKeyView"
      }
    }
  }
}
