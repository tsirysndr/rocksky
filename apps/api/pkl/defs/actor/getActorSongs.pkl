amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.actor.getActorSongs"
defs = new Mapping<String, BaseType> {
  ["main"] = new Query {
    type = "query"
    description = "Get songs for an actor"
    parameters = new {
      type = "params"
      required = List("did")
      properties = new Mapping<String, BaseType> {
        ["did"] = new StringType {
          type = "string"
          description = "The DID or handle of the actor"
          format = "at-identifier"
        }
        ["limit"] = new IntegerType {
          type = "integer"
          description = "The maximum number of albums to return"
          minimum = 1
        }
        ["offset"] = new IntegerType {
          type = "integer"
          description = "The offset for pagination"
          minimum = 0
        }
        ["startDate"] = new StringType {
          type = "string"
          description = "The start date to filter albums from (ISO 8601 format)"
          format = "datetime"
        }
        ["endDate"] = new StringType {
          type = "string"
          description = "The end date to filter albums to (ISO 8601 format)"
          format = "datetime"
        }
      }
    }
    output = new {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        properties = new Mapping<String, BaseType> {
          ["tracks"] = new Array {
            type = "array"
            items = new Ref {
              type = "ref"
              ref = "app.rocksky.song.defs#songViewBasic"
            }
          }
        }
      }
    }
  }
}
