amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.playlist.addSongs"
defs = new Mapping<String, Procedure> {
  ["main"] {
    type = "procedure"
    description =
      "Add songs to a playlist. Publishes one app.rocksky.playlist.song record per song to the caller's repo; only the playlist owner may do so."
    parameters = new Params {
      required = List("uri", "songs")
      properties {
        ["uri"] = new StringType {
          type = "string"
          description = "The URI of the playlist to add the songs to"
          format = "at-uri"
        }
        ["songs"] = new Array {
          type = "array"
          description = "AT-URIs of the app.rocksky.song records to add"
          items = new StringType {
            type = "string"
            format = "at-uri"
          }
        }
      }
    }
    output {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        required = List("uris")
        properties {
          ["uris"] = new Array {
            type = "array"
            description = "AT-URIs of the created app.rocksky.playlist.song records"
            items = new StringType {
              type = "string"
              format = "at-uri"
            }
          }
        }
      }
    }
  }
}
