amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.playlist.updatePlaylist"
defs = new Mapping<String, Procedure> {
  ["main"] {
    type = "procedure"
    description =
      "Update a playlist's metadata. Rewrites the app.rocksky.playlist record in place; only the owner may do so."
    parameters = new Params {
      required = List("uri")
      properties {
        ["uri"] = new StringType {
          type = "string"
          description = "The URI of the playlist to update"
          format = "at-uri"
        }
        ["name"] = new StringType {
          type = "string"
          description = "The new name of the playlist"
          minLength = 1
          maxLength = 512
        }
        ["description"] = new StringType {
          type = "string"
          description = "The new description of the playlist"
          maxLength = 256
        }
        ["pictureUrl"] = new StringType {
          type = "string"
          description = "The new cover image URL for the playlist"
          format = "uri"
        }
      }
    }
    output {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        required = List("uri", "cid")
        properties {
          ["uri"] = new StringType {
            type = "string"
            description = "The AT-URI of the updated app.rocksky.playlist record."
            format = "at-uri"
          }
          ["cid"] = new StringType {
            type = "string"
            description = "The CID of the updated app.rocksky.playlist record."
          }
        }
      }
    }
  }
}
