amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.playlist.removeTrack"
defs = new Mapping<String, Procedure> {
  ["main"] {
    type = "procedure"
    description =
      "Remove one track from a playlist. Deletes the app.rocksky.playlist.song record that put it there, which only the repo that added it can do. Prefer `index`: a song can sit in a playlist more than once, and `songUri` alone cannot say which copy to drop."
    parameters = new Params {
      required = List("uri")
      properties {
        ["uri"] = new StringType {
          type = "string"
          description = "The URI of the playlist to remove the track from"
          format = "at-uri"
        }
        ["songUri"] = new StringType {
          type = "string"
          description = "The URI of the app.rocksky.song record to remove. Removes every copy of it; pass `index` instead to remove one."
          format = "at-uri"
        }
        ["index"] = new IntegerType {
          type = "integer"
          description = "0-based position of the entry to remove, in the order getPlaylist returns."
          minimum = 0
        }
      }
    }
  }
}
