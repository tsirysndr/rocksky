amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.playlist.song"
defs = new Mapping<String, Record> {
  ["main"] {
    type = "record"
    key = "tid"
    description =
      "A song entry in a playlist. Holds a strong reference to the playlist it belongs to, a strong reference to the song record itself, and a denormalized copy of the song metadata so the entry can be rendered without dereferencing the song."
    `record` {
      type = "object"
      required = List(
        "playlist",
        "song",
        "title",
        "artist",
        "album",
        "albumArtist",
        "duration",
        "addedAt"
      )
      properties {
        ["playlist"] = new Ref {
          type = "ref"
          description = "Strong reference (AT-URI + CID) to the parent app.rocksky.playlist record."
          ref = "com.atproto.repo.strongRef"
        }
        ["song"] = new Ref {
          type = "ref"
          description = "Strong reference (AT-URI + CID) to the app.rocksky.song record this entry points at."
          ref = "com.atproto.repo.strongRef"
        }
        ["title"] = new StringType {
          type = "string"
          description = "The title of the song."
          minLength = 1
          maxLength = 512
        }
        ["artist"] = new StringType {
          type = "string"
          description = "The artist of the song."
          minLength = 1
          maxLength = 256
        }
        ["album"] = new StringType {
          type = "string"
          description = "The album the song belongs to."
          minLength = 1
          maxLength = 256
        }
        ["albumArtist"] = new StringType {
          type = "string"
          description = "The album artist of the song."
          minLength = 1
          maxLength = 256
        }
        ["duration"] = new IntegerType {
          type = "integer"
          description = "The duration of the song in milliseconds."
          minimum = 1
        }
        ["albumArtUrl"] = new StringType {
          type = "string"
          description = "The URL of the album art of the song."
          format = "uri"
        }
        ["addedAt"] = new StringType {
          type = "string"
          description = "The date and time the song was added to the playlist."
          format = "datetime"
        }
      }
    }
  }
}
