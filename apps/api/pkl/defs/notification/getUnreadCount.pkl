amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.notification.getUnreadCount"
defs = new Mapping<String, Query> {
  ["main"] {
    type = "query"
    description = "Get the number of unread notifications for the authenticated user."
    output {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        required = List("count")
        properties {
          ["count"] = new IntegerType {
            type = "integer"
            description = "The number of unread notifications."
          }
        }
      }
    }
  }
}
