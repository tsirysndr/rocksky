amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.song.defs"
defs = new Mapping<String, BaseType> {
  ["songViewBasic"] = new ObjectType {
    type = "object"
    properties = new Mapping<String, BaseType> {
      ["id"] = new StringType {
        type = "string"
        description = "The unique identifier of the song."
      }
      ["title"] = new StringType {
        type = "string"
        description = "The title of the song."
      }
      ["artist"] = new StringType {
        type = "string"
        description = "The artist of the song."
      }
      ["albumArtist"] = new StringType {
        type = "string"
        description = "The artist of the album the song belongs to."
      }
      ["albumArt"] = new StringType {
        type = "string"
        description = "The URL of the album art image."
        format = "uri"
      }
      ["uri"] = new StringType {
        type = "string"
        description = "The URI of the song."
        format = "at-uri"
      }
      ["album"] = new StringType {
        type = "string"
        description = "The album of the song."
      }
      ["duration"] = new IntegerType {
        type = "integer"
        description = "The duration of the song in milliseconds."
      }
      ["trackNumber"] = new IntegerType {
        type = "integer"
        description = "The track number of the song in the album."
      }
      ["discNumber"] = new IntegerType {
        type = "integer"
        description = "The disc number of the song in the album."
      }
      ["playCount"] = new IntegerType {
        type = "integer"
        description = "The number of times the song has been played."
        minimum = 0
      }
      ["likesCount"] = new IntegerType {
        type = "integer"
        description = "The number of users who have loved this song."
        minimum = 0
      }
      ["liked"] = new BooleanType {
        type = "boolean"
        description = "Whether the authenticated user has loved this song. False when unauthenticated."
      }
      ["uniqueListeners"] = new IntegerType {
        type = "integer"
        description = "The number of unique listeners who have played the song."
        minimum = 0
      }
      ["albumUri"] = new StringType {
        type = "string"
        description = "The URI of the album the song belongs to."
        format = "at-uri"
      }
      ["artistUri"] = new StringType {
        type = "string"
        description = "The URI of the artist of the song."
        format = "at-uri"
      }
      ["sha256"] = new StringType {
        type = "string"
        description = "The SHA256 hash of the song."
      }
      ["mbid"] = new StringType {
        type = "string"
        description = "The MusicBrainz ID of the song."
      }
      ["isrc"] = new StringType {
        type = "string"
        description = "The International Standard Recording Code (ISRC) of the song."
      }
      ["tags"] = new Array {
        type = "array"
        items = new StringType {
          type = "string"
        }
      }
      ["createdAt"] = new StringType {
        type = "string"
        description = "The timestamp when the song was created."
        format = "datetime"
      }
      ["updatedAt"] = new StringType {
        type = "string"
      }
      ["mbId"] = new StringType {
        type = "string"
      }
      ["youtubeLink"] = new StringType {
        type = "string"
      }
      ["spotifyLink"] = new StringType {
        type = "string"
      }
      ["appleMusicLink"] = new StringType {
        type = "string"
      }
      ["tidalLink"] = new StringType {
        type = "string"
      }
      ["lyrics"] = new StringType {
        type = "string"
      }
      ["composer"] = new StringType {
        type = "string"
      }
      ["genre"] = new StringType {
        type = "string"
      }
      ["label"] = new StringType {
        type = "string"
      }
      ["copyrightMessage"] = new StringType {
        type = "string"
      }
      ["key"] = new StringType {
        type = "string"
      }
      ["acoustidFingerprint"] = new StringType {
        type = "string"
      }
      ["xataVersion"] = new IntegerType {
        type = "integer"
      }
    }
    nullable = List("acoustidFingerprint", "albumArt", "albumUri", "appleMusicLink", "artistUri", "composer", "copyrightMessage", "discNumber", "genre", "isrc", "key", "label", "lyrics", "mbId", "spotifyLink", "tidalLink", "trackNumber", "uri", "xataVersion", "youtubeLink")
  }
  ["songViewDetailed"] = new ObjectType {
    type = "object"
    properties = new Mapping<String, BaseType> {
      ["id"] = new StringType {
        type = "string"
        description = "The unique identifier of the song."
      }
      ["title"] = new StringType {
        type = "string"
        description = "The title of the song."
      }
      ["artist"] = new StringType {
        type = "string"
        description = "The artist of the song."
      }
      ["albumArtist"] = new StringType {
        type = "string"
        description = "The artist of the album the song belongs to."
      }
      ["albumArt"] = new StringType {
        type = "string"
        description = "The URL of the album art image."
        format = "uri"
      }
      ["uri"] = new StringType {
        type = "string"
        description = "The URI of the song."
        format = "at-uri"
      }
      ["album"] = new StringType {
        type = "string"
        description = "The album of the song."
      }
      ["duration"] = new IntegerType {
        type = "integer"
        description = "The duration of the song in milliseconds."
      }
      ["trackNumber"] = new IntegerType {
        type = "integer"
        description = "The track number of the song in the album."
      }
      ["discNumber"] = new IntegerType {
        type = "integer"
        description = "The disc number of the song in the album."
      }
      ["playCount"] = new IntegerType {
        type = "integer"
        description = "The number of times the song has been played."
        minimum = 0
      }
      ["likesCount"] = new IntegerType {
        type = "integer"
        description = "The number of users who have loved this song."
        minimum = 0
      }
      ["liked"] = new BooleanType {
        type = "boolean"
        description = "Whether the authenticated user has loved this song. False when unauthenticated."
      }
      ["uniqueListeners"] = new IntegerType {
        type = "integer"
        description = "The number of unique listeners who have played the song."
        minimum = 0
      }
      ["albumUri"] = new StringType {
        type = "string"
        description = "The URI of the album the song belongs to."
        format = "at-uri"
      }
      ["artistUri"] = new StringType {
        type = "string"
        description = "The URI of the artist of the song."
        format = "at-uri"
      }
      ["sha256"] = new StringType {
        type = "string"
        description = "The SHA256 hash of the song."
      }
      ["mbid"] = new StringType {
        type = "string"
        description = "The MusicBrainz ID of the song."
      }
      ["isrc"] = new StringType {
        type = "string"
        description = "The International Standard Recording Code (ISRC) of the song."
      }
      ["tags"] = new Array {
        type = "array"
        items = new StringType {
          type = "string"
        }
      }
      ["createdAt"] = new StringType {
        type = "string"
        description = "The timestamp when the song was created."
        format = "datetime"
      }
      ["artists"] = new Array {
        type = "array"
        items = new Ref {
          type = "ref"
          ref = "app.rocksky.artist.defs#artistViewBasic"
        }
      }
      ["firstScrobble"] = new Ref {
        type = "ref"
        description = "The first scrobble of this song on Rocksky."
        ref = "app.rocksky.song.defs#firstScrobbleView"
      }
      ["matches"] = new Array {
        type = "array"
        description = "Ranked list of candidate matches from external metadata providers (e.g. Deezer). Additive field returned by matchSong; may be empty."
        items = new Ref {
          type = "ref"
          ref = "app.rocksky.song.defs#songMatchView"
        }
      }
      ["mbId"] = new StringType {
        type = "string"
        description = "The MusicBrainz recording ID of the track, when available."
      }
      ["updatedAt"] = new StringType {
        type = "string"
      }
      ["releaseDate"] = new StringType {
        type = "string"
      }
      ["year"] = new IntegerType {
        type = "integer"
      }
      ["artistPicture"] = new StringType {
        type = "string"
      }
      ["genres"] = new Array {
        type = "array"
        items = new StringType {
          type = "string"
        }
      }
      ["mbArtists"] = new Array {
        type = "array"
        items = new Ref {
          type = "ref"
          ref = "app.rocksky.song.defs#responseMbArtistsItemView"
        }
      }
      ["youtubeLink"] = new StringType {
        type = "string"
      }
      ["spotifyLink"] = new StringType {
        type = "string"
      }
      ["appleMusicLink"] = new StringType {
        type = "string"
      }
      ["tidalLink"] = new StringType {
        type = "string"
      }
      ["lyrics"] = new StringType {
        type = "string"
      }
      ["composer"] = new StringType {
        type = "string"
      }
      ["genre"] = new StringType {
        type = "string"
      }
      ["label"] = new StringType {
        type = "string"
      }
      ["copyrightMessage"] = new StringType {
        type = "string"
      }
      ["key"] = new StringType {
        type = "string"
      }
      ["acoustidFingerprint"] = new StringType {
        type = "string"
      }
      ["xataVersion"] = new IntegerType {
        type = "integer"
      }
    }
    nullable = List("acoustidFingerprint", "albumArt", "albumUri", "appleMusicLink", "artistPicture", "artistUri", "composer", "copyrightMessage", "discNumber", "genre", "genres", "isrc", "key", "label", "lyrics", "mbArtists", "mbId", "releaseDate", "spotifyLink", "tidalLink", "trackNumber", "uri", "xataVersion", "year", "youtubeLink")
  }
  ["songMatchView"] = new ObjectType {
    type = "object"
    description = "A ranked candidate match for a song from an external metadata provider."
    properties = new Mapping<String, BaseType> {
      ["id"] = new IntegerType {
        type = "integer"
        description = "The provider's numeric identifier for the matched track."
      }
      ["title"] = new StringType {
        type = "string"
        description = "The title of the matched track."
      }
      ["artist"] = new StringType {
        type = "string"
        description = "The artist of the matched track."
      }
      ["album"] = new StringType {
        type = "string"
        description = "The album of the matched track."
      }
      ["albumArt"] = new StringType {
        type = "string"
        description = "The URL of the matched track's album art image."
        format = "uri"
      }
      ["isrc"] = new StringType {
        type = "string"
        description = "The International Standard Recording Code (ISRC) of the matched track."
      }
      ["durationMs"] = new IntegerType {
        type = "integer"
        description = "The duration of the matched track in milliseconds."
        minimum = 0
      }
      ["trackNumber"] = new IntegerType {
        type = "integer"
        description = "The track number of the matched track in its album."
      }
      ["discNumber"] = new IntegerType {
        type = "integer"
        description = "The disc number of the matched track in its album."
      }
      ["link"] = new StringType {
        type = "string"
        description = "A URL to the matched track on the provider."
        format = "uri"
      }
      ["preview"] = new StringType {
        type = "string"
        description = "A URL to a short audio preview of the matched track."
        format = "uri"
      }
      ["rank"] = new IntegerType {
        type = "integer"
        description = "The provider's popularity rank for the matched track."
      }
      ["explicit"] = new BooleanType {
        type = "boolean"
        description = "Whether the matched track has explicit lyrics."
      }
      ["score"] = new IntegerType {
        type = "integer"
        description = "Match confidence score in the range 0-100 (higher is better)."
        maximum = 100
        minimum = 0
      }
    }
  }
  ["recentListenerView"] = new ObjectType {
    type = "object"
    properties = new Mapping<String, BaseType> {
      ["id"] = new StringType {
        type = "string"
        description = "The unique identifier of the listener."
      }
      ["did"] = new StringType {
        type = "string"
        description = "The DID of the listener."
      }
      ["handle"] = new StringType {
        type = "string"
        description = "The handle of the listener."
      }
      ["displayName"] = new StringType {
        type = "string"
        description = "The display name of the listener."
      }
      ["avatar"] = new StringType {
        type = "string"
        description = "The URL of the listener's avatar image."
        format = "uri"
      }
      ["timestamp"] = new StringType {
        type = "string"
        description = "The timestamp of the listener's most recent scrobble of this song."
        format = "datetime"
      }
      ["scrobbleUri"] = new StringType {
        type = "string"
        description = "The URI of the listener's most recent scrobble of this song."
        format = "at-uri"
      }
    }
  }
  ["firstScrobbleView"] = new ObjectType {
    type = "object"
    properties = new Mapping<String, BaseType> {
      ["handle"] = new StringType {
        type = "string"
        description = "The handle of the user who first scrobbled this song."
      }
      ["avatar"] = new StringType {
        type = "string"
        description = "The avatar URL of the user who first scrobbled this song."
        format = "uri"
      }
      ["timestamp"] = new StringType {
        type = "string"
        description = "The timestamp of the first scrobble."
        format = "datetime"
      }
    }
  }
  ["responseMbArtistsItemView"] = new ObjectType {
    type = "object"
    properties = new Mapping<String, BaseType> {
      ["mbid"] = new StringType {
        type = "string"
      }
      ["name"] = new StringType {
        type = "string"
      }
    }
  }
}
