amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.song.matchSong"
defs = new Mapping<String, Query> {
  ["main"] {
    type = "query"
    description = "Matches a song against Rocksky’s music database and external metadata providers to resolve the best canonical track, artist, and album. Returns the existing song view on HTTP 200. HTTP 409 AmbiguousMatch means multiple recordings remain; HTTP 404 NotFound means no match. Both error bodies include status (ambiguous or unmatched), policyVersion, candidates (songMatchView objects, including catalog candidates), and warnings. Resolve ambiguity by supplying a known isrc or mbId; candidates are not a selected recording."
    parameters = new Params {
      required = List("title", "artist")
      properties {
        ["title"] = new StringType {
          description = "The title of the song to retrieve"
        }
        ["artist"] = new StringType {
          description = "The artist of the song to retrieve"
        }
        ["album"] = new StringType {
          description = "Optional album title — only candidates matching this album after normalization are accepted, including when an explicit identifier is supplied"
        }
        ["mbId"] = new StringType {
          description = "Optional MusicBrainz recording ID to anchor the match"
        }
        ["isrc"] = new StringType {
          description = "Optional International Standard Recording Code (ISRC) to anchor the match"
        }
      }
    }
    output {
      encoding = "application/json"
      schema = new Ref {
        type = "ref"
        ref = "app.rocksky.song.defs#songViewDetailed"
      }
    }
  }
}
