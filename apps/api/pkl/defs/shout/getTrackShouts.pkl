amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.shout.getTrackShouts"
defs = new Mapping<String, BaseType> {
  ["main"] = new Query {
    type = "query"
    description = "Get all shouts for a specific track"
    parameters = new {
      type = "params"
      required = List("uri")
      properties = new Mapping<String, BaseType> {
        ["uri"] = new StringType {
          type = "string"
          description = "The URI of the track to retrieve shouts for"
          format = "at-uri"
        }
      }
    }
    output = new {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        properties = new Mapping<String, BaseType> {
          ["shouts"] = new Array {
            type = "array"
            items = new Ref {
              type = "ref"
              ref = "app.rocksky.shout.defs#shoutView"
            }
          }
        }
      }
    }
  }
}
