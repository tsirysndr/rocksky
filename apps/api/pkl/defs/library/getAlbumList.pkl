amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.library.getAlbumList"
defs = new Mapping<String, BaseType> {
  ["main"] = new Query {
    type = "query"
    description = "Get a list of albums by various criteria."
    parameters = new {
      type = "params"
      required = List("type")
      properties = new Mapping<String, BaseType> {
        ["type"] = new StringType {
          type = "string"
          description = "List type: newest, alphabeticalByName, alphabeticalByArtist, random, recent, byYear, byGenre, starred."
        }
        ["size"] = new IntegerType {
          type = "integer"
          description = "Number of albums to return (max 500)."
        }
        ["offset"] = new IntegerType {
          type = "integer"
          description = "Offset for pagination."
          minimum = 0
        }
        ["fromYear"] = new IntegerType {
          type = "integer"
          description = "First year in a byYear range."
        }
        ["toYear"] = new IntegerType {
          type = "integer"
          description = "Last year in a byYear range."
        }
        ["genre"] = new StringType {
          type = "string"
          description = "Genre name when type is byGenre."
        }
      }
    }
    output = new {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        properties = new Mapping<String, BaseType> {
          ["status"] = new StringType {
            type = "string"
          }
          ["version"] = new StringType {
            type = "string"
          }
          ["type"] = new StringType {
            type = "string"
          }
          ["serverVersion"] = new StringType {
            type = "string"
          }
          ["openSubsonic"] = new BooleanType {
            type = "boolean"
          }
          ["albumList2"] = new UnknownType {
            type = "unknown"
            description = "Unmodified OpenSubsonic albumList2 payload from Navidrome. Its provider-defined fields are preserved."
          }
        }
      }
    }
  }
}
