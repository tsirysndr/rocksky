amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.library.savePlayQueue"
defs = new Mapping<String, BaseType> {
  ["main"] = new Procedure {
    type = "procedure"
    description = "Save the play queue for the user."
    input = new {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        properties = new Mapping<String, BaseType> {
          ["id"] = new StringType {
            type = "string"
            description = "Comma-separated song ids in the queue."
          }
          ["current"] = new StringType {
            type = "string"
            description = "The id of the currently playing song."
          }
          ["position"] = new IntegerType {
            type = "integer"
            description = "Position within the current song, in milliseconds."
          }
        }
      }
    }
    output = new {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        properties = new Mapping<String, BaseType> {
          ["status"] = new StringType {
            type = "string"
          }
          ["version"] = new StringType {
            type = "string"
          }
          ["type"] = new StringType {
            type = "string"
          }
          ["serverVersion"] = new StringType {
            type = "string"
          }
          ["openSubsonic"] = new BooleanType {
            type = "boolean"
          }
        }
      }
    }
  }
}
