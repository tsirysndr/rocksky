amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.library.getGenres"
defs = new Mapping<String, BaseType> {
  ["main"] = new Query {
    type = "query"
    description = "Get all genres in the library."
    parameters = new {
      type = "params"
      properties = new Mapping<String, BaseType> {
      }
    }
    output = new {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        properties = new Mapping<String, BaseType> {
          ["status"] = new StringType {
            type = "string"
          }
          ["version"] = new StringType {
            type = "string"
          }
          ["type"] = new StringType {
            type = "string"
          }
          ["serverVersion"] = new StringType {
            type = "string"
          }
          ["openSubsonic"] = new BooleanType {
            type = "boolean"
          }
          ["genres"] = new UnknownType {
            type = "unknown"
            description = "Unmodified OpenSubsonic genres payload from Navidrome. Its provider-defined fields are preserved."
          }
        }
      }
    }
  }
}
