amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.library.getSongsByGenre"
defs = new Mapping<String, BaseType> {
  ["main"] = new Query {
    type = "query"
    description = "Get songs in a given genre."
    parameters = new {
      type = "params"
      required = List("genre")
      properties = new Mapping<String, BaseType> {
        ["genre"] = new StringType {
          type = "string"
          description = "The genre name."
        }
        ["count"] = new IntegerType {
          type = "integer"
          description = "Number of songs to return (max 500)."
        }
        ["offset"] = new IntegerType {
          type = "integer"
          description = "Offset for pagination."
          minimum = 0
        }
      }
    }
    output = new {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        properties = new Mapping<String, BaseType> {
          ["status"] = new StringType {
            type = "string"
          }
          ["version"] = new StringType {
            type = "string"
          }
          ["type"] = new StringType {
            type = "string"
          }
          ["serverVersion"] = new StringType {
            type = "string"
          }
          ["openSubsonic"] = new BooleanType {
            type = "boolean"
          }
          ["songsByGenre"] = new UnknownType {
            type = "unknown"
            description = "Unmodified OpenSubsonic songsByGenre payload from Navidrome. Its provider-defined fields are preserved."
          }
        }
      }
    }
  }
}
