amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.library.search"
defs = new Mapping<String, BaseType> {
  ["main"] = new Query {
    type = "query"
    description = "Search for artists, albums and songs."
    parameters = new {
      type = "params"
      required = List("query")
      properties = new Mapping<String, BaseType> {
        ["query"] = new StringType {
          type = "string"
          description = "The search query."
        }
        ["artistCount"] = new IntegerType {
          type = "integer"
          description = "Maximum number of artists to return."
        }
        ["artistOffset"] = new IntegerType {
          type = "integer"
          description = "Artist result offset."
          minimum = 0
        }
        ["albumCount"] = new IntegerType {
          type = "integer"
          description = "Maximum number of albums to return."
        }
        ["albumOffset"] = new IntegerType {
          type = "integer"
          description = "Album result offset."
          minimum = 0
        }
        ["songCount"] = new IntegerType {
          type = "integer"
          description = "Maximum number of songs to return."
        }
        ["songOffset"] = new IntegerType {
          type = "integer"
          description = "Song result offset."
          minimum = 0
        }
      }
    }
    output = new {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        properties = new Mapping<String, BaseType> {
          ["status"] = new StringType {
            type = "string"
          }
          ["version"] = new StringType {
            type = "string"
          }
          ["type"] = new StringType {
            type = "string"
          }
          ["serverVersion"] = new StringType {
            type = "string"
          }
          ["openSubsonic"] = new BooleanType {
            type = "boolean"
          }
          ["searchResult3"] = new UnknownType {
            type = "unknown"
            description = "Unmodified OpenSubsonic searchResult3 payload from Navidrome. Its provider-defined fields are preserved."
          }
        }
      }
    }
  }
}
