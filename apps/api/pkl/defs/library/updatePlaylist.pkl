amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.library.updatePlaylist"
defs = new Mapping<String, BaseType> {
  ["main"] = new Procedure {
    type = "procedure"
    description = "Update an existing playlist."
    input = new {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        required = List("playlistId")
        properties = new Mapping<String, BaseType> {
          ["playlistId"] = new StringType {
            type = "string"
            description = "The playlist id to update."
          }
          ["name"] = new StringType {
            type = "string"
            description = "New playlist name."
          }
          ["comment"] = new StringType {
            type = "string"
            description = "New playlist comment."
          }
          ["songIdToAdd"] = new StringType {
            type = "string"
            description = "A song id to add to the playlist."
          }
          ["songIndexToRemove"] = new IntegerType {
            type = "integer"
            description = "A track index to remove from the playlist."
          }
        }
      }
    }
    output = new {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        properties = new Mapping<String, BaseType> {
          ["status"] = new StringType {
            type = "string"
          }
          ["version"] = new StringType {
            type = "string"
          }
          ["type"] = new StringType {
            type = "string"
          }
          ["serverVersion"] = new StringType {
            type = "string"
          }
          ["openSubsonic"] = new BooleanType {
            type = "boolean"
          }
          ["atprotoError"] = new StringType {
            type = "string"
            description = "Non-fatal AT Protocol playlist mirror error, when available."
          }
        }
      }
    }
  }
}
