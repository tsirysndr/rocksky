amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.library.getSimilarSongs"
defs = new Mapping<String, BaseType> {
  ["main"] = new Query {
    type = "query"
    description = "Get songs similar to the given artist."
    parameters = new {
      type = "params"
      required = List("id")
      properties = new Mapping<String, BaseType> {
        ["id"] = new StringType {
          type = "string"
          description = "The artist, album or song id"
        }
        ["count"] = new IntegerType {
          type = "integer"
          description = "Number of songs to return."
        }
      }
    }
    output = new {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        properties = new Mapping<String, BaseType> {
          ["status"] = new StringType {
            type = "string"
          }
          ["version"] = new StringType {
            type = "string"
          }
          ["type"] = new StringType {
            type = "string"
          }
          ["serverVersion"] = new StringType {
            type = "string"
          }
          ["openSubsonic"] = new BooleanType {
            type = "boolean"
          }
          ["similarSongs2"] = new UnknownType {
            type = "unknown"
            description = "Unmodified OpenSubsonic similarSongs2 payload from Navidrome. Its provider-defined fields are preserved."
          }
        }
      }
    }
  }
}
