amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.library.createPlaylist"
defs = new Mapping<String, BaseType> {
  ["main"] = new Procedure {
    type = "procedure"
    description = "Create a new playlist."
    input = new {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        required = List("name")
        properties = new Mapping<String, BaseType> {
          ["name"] = new StringType {
            type = "string"
            description = "The playlist name."
          }
        }
      }
    }
    output = new {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        properties = new Mapping<String, BaseType> {
          ["status"] = new StringType {
            type = "string"
          }
          ["version"] = new StringType {
            type = "string"
          }
          ["type"] = new StringType {
            type = "string"
          }
          ["serverVersion"] = new StringType {
            type = "string"
          }
          ["openSubsonic"] = new BooleanType {
            type = "boolean"
          }
          ["playlist"] = new UnknownType {
            type = "unknown"
            description = "Unmodified OpenSubsonic playlist payload from Navidrome. Its provider-defined fields are preserved."
          }
          ["atprotoError"] = new StringType {
            type = "string"
            description = "Non-fatal AT Protocol playlist mirror error, when available."
          }
        }
      }
    }
  }
}
