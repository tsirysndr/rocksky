amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.library.scrobble"
defs = new Mapping<String, BaseType> {
  ["main"] = new Procedure {
    type = "procedure"
    description = "Register a play (scrobble) for a song."
    input = new {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        required = List("id")
        properties = new Mapping<String, BaseType> {
          ["id"] = new StringType {
            type = "string"
            description = "The song id."
          }
          ["time"] = new IntegerType {
            type = "integer"
            description = "Play time as a Unix timestamp in milliseconds."
          }
          ["submission"] = new BooleanType {
            type = "boolean"
            description = "True for a final submission, false for a now-playing update."
          }
        }
      }
    }
    output = new {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        properties = new Mapping<String, BaseType> {
          ["status"] = new StringType {
            type = "string"
          }
          ["version"] = new StringType {
            type = "string"
          }
          ["type"] = new StringType {
            type = "string"
          }
          ["serverVersion"] = new StringType {
            type = "string"
          }
          ["openSubsonic"] = new BooleanType {
            type = "boolean"
          }
        }
      }
    }
  }
}
