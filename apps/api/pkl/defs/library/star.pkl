amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.library.star"
defs = new Mapping<String, BaseType> {
  ["main"] = new Procedure {
    type = "procedure"
    description = "Star a song, album or artist."
    input = new {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        required = List("id")
        properties = new Mapping<String, BaseType> {
          ["id"] = new StringType {
            type = "string"
            description = "The song id to star."
          }
          ["albumId"] = new StringType {
            type = "string"
            description = "An album id to star."
          }
          ["artistId"] = new StringType {
            type = "string"
            description = "An artist id to star."
          }
        }
      }
    }
    output = new {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        properties = new Mapping<String, BaseType> {
          ["status"] = new StringType {
            type = "string"
          }
          ["version"] = new StringType {
            type = "string"
          }
          ["type"] = new StringType {
            type = "string"
          }
          ["serverVersion"] = new StringType {
            type = "string"
          }
          ["openSubsonic"] = new BooleanType {
            type = "boolean"
          }
        }
      }
    }
  }
}
