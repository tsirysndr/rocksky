amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.library.getLyrics"
defs = new Mapping<String, BaseType> {
  ["main"] = new Query {
    type = "query"
    description = "Get lyrics for a song."
    parameters = new {
      type = "params"
      properties = new Mapping<String, BaseType> {
        ["artist"] = new StringType {
          type = "string"
          description = "The artist name."
        }
        ["title"] = new StringType {
          type = "string"
          description = "The song title."
        }
      }
    }
    output = new {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        properties = new Mapping<String, BaseType> {
          ["status"] = new StringType {
            type = "string"
          }
          ["version"] = new StringType {
            type = "string"
          }
          ["type"] = new StringType {
            type = "string"
          }
          ["serverVersion"] = new StringType {
            type = "string"
          }
          ["openSubsonic"] = new BooleanType {
            type = "boolean"
          }
          ["lyrics"] = new UnknownType {
            type = "unknown"
            description = "Unmodified OpenSubsonic lyrics payload from Navidrome. Its provider-defined fields are preserved."
          }
        }
      }
    }
  }
}
