amends "../../schema/lexicon.pkl"

lexicon = 1
id = "app.rocksky.library.getTopSongs"
defs = new Mapping<String, BaseType> {
  ["main"] = new Query {
    type = "query"
    description = "Get the top songs for an artist."
    parameters = new {
      type = "params"
      required = List("artist")
      properties = new Mapping<String, BaseType> {
        ["artist"] = new StringType {
          type = "string"
          description = "The artist name."
        }
        ["count"] = new IntegerType {
          type = "integer"
          description = "Number of songs to return."
        }
      }
    }
    output = new {
      encoding = "application/json"
      schema = new ObjectType {
        type = "object"
        properties = new Mapping<String, BaseType> {
          ["status"] = new StringType {
            type = "string"
          }
          ["version"] = new StringType {
            type = "string"
          }
          ["type"] = new StringType {
            type = "string"
          }
          ["serverVersion"] = new StringType {
            type = "string"
          }
          ["openSubsonic"] = new BooleanType {
            type = "boolean"
          }
          ["topSongs"] = new UnknownType {
            type = "unknown"
            description = "Unmodified OpenSubsonic topSongs payload from Navidrome. Its provider-defined fields are preserved."
          }
        }
      }
    }
  }
}
