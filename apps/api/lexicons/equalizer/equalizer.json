{
  "lexicon": 1,
  "id": "app.rocksky.equalizer",
  "defs": {
    "main": {
      "type": "record",
      "description": "A saved equalizer preset. The rkey is the preset name slugified: lower case, dashes, no spaces (e.g. \"Bass Boost\" -> \"bass-boost\").",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "name",
          "bands",
          "createdAt"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Display name of the preset.",
            "minLength": 1,
            "maxLength": 64
          },
          "precut": {
            "type": "integer",
            "description": "Pre-amplification cut in tenths of dB applied before EQ bands (e.g. -60 = -6.0 dB)",
            "maximum": 0,
            "minimum": -240
          },
          "bands": {
            "type": "array",
            "description": "Up to 10 EQ bands",
            "items": {
              "type": "ref",
              "ref": "app.rocksky.rockbox.defs#equalizerBand"
            }
          },
          "createdAt": {
            "type": "string",
            "description": "When this preset was first created.",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "description": "When this preset was last updated.",
            "format": "datetime"
          }
        }
      }
    }
  }
}
